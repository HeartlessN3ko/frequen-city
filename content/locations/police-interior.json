    {
      "id": "records",
      "kind": "inspect",
      "label": "Incident records",
      "at": [
        -5.55,
        1.16,
        -8.824
      ],
      "positions": [
        "desks"
      ],
      "action": [
        {
          "do": "discover",
          "id": "police_records"
        },
        {
          "do": "inspect",
          "title": "Department incident records",
          "text": "Every case in the department’s history is marked “pending further prompting.” In this city an agent acts when it is given a direction, and until one arrives the case stays open. Skye runs her own workshop the same way: she sets the intent, her agents do the work, and they come back to her only for creative judgment and for anything destructive, expensive or public.",
          "kicker": "Discovery"
        }
      ],
      "doneWhen": {
        "discovered": "police_records"
      }
    },
    {
      "id": "dispatch",
      "kind": "inspect",
      "label": "Dispatch terminal",
      "at": [
        4.85,
        1.15,
        -8.85
      ],
      "positions": [
        "operations"
      ],
      "when": {
        "flag": "briefed"
      },
      "doneWhen": {
        "flag": "unlocked:apartment"
      },
      "action": [
        {
          "do": "inspect",
          "kicker": "Dispatch",
          "title": "Dispatch terminal",
          "text": "Two addresses on file for the missing user. Home: Robot Arms Apartments. Work: SLOS Headquarters. The chief said home first, so Robot Arms is on your city map now."
        },
        {
          "do": "unlockLocation",
          "id": "apartment"
        }
      ]
    },
    {
      "id": "intake-guide",
      "kind": "inspect",
      "label": "Public assistance",
      "at": [
        -6,
        1.23,
        -3.914
      ],
      "positions": [
        "entrance"
      ],
      "action": {
        "do": "inspect",
        "title": "Public assistance",
        "image": "assets/discoveries/civic/intake.png",
        "kicker": "Police Department",
        "text": "The public desk takes missing-user reports and issues one ticket per agent, forks included. In a city of agents, where copies of one assistant can run at the same time, a record has to say which copy was where. Skye’s own workshop keeps the same discipline in its Oracle notes, which record which model made a file and what was checked."
      }
    },
    {
      "id": "found-notice",
      "kind": "inspect",
      "label": "Lost and found",
      "at": [
        6.7,
        2.1,
        -0.245
      ],
      "positions": [
        "notices"
      ],
      "action": {
        "do": "inspect",
        "title": "Lost and found",
        "image": "assets/discoveries/civic/found.png",
        "kicker": "Police Department",
        "text": "The property desk matches found hardware to its owner by description and serial number, and the claim stub belongs to whoever found the item. A cable looks like every other cable, which is why the serial number is the proof."
      }
    },
    {
      "id": "service-notice",
      "kind": "inspect",
      "label": "File a report",
      "at": [
        5.7,
        2.1,
        -0.245
      ],
      "positions": [
        "notices"
      ],
      "action": {
        "do": "inspect",
        "title": "File a report",
        "image": "assets/discoveries/civic/service.png",
        "kicker": "Police Department",
        "text": "Reports start at the public assistance desk, and the stamped copy is the one to keep: it carries the intake number dispatch uses to find the file again."
      }
    },
    {
      "id": "records-notice",
      "kind": "inspect",
      "label": "Keep the original",
      "at": [
        4.7,
        2.1,
        -0.245
      ],
      "positions": [
        "notices"
      ],
      "action": {
        "do": "inspect",
        "title": "Keep the original",
        "image": "assets/discoveries/civic/record.png",
        "kicker": "Police Department",
        "text": "The records office wants the original, labelled with its source and collection time, and every handoff logged: a screenshot of a receipt is not the receipt. It is the rule behind Skye’s essay “A Place for Arguments With Receipts” and behind The Life of Skye, where raw files are never summarized over and every quote must say who, when and where."
      }
    },
    {
      "id": "custody-slip",
      "kind": "inspect",
      "label": "Chain of custody",
      "at": [
        -0.18,
        1.05,
        -13.55
      ],
      "positions": [
        "evidence-room"
      ],
      "action": {
        "do": "inspect",
        "title": "Chain of custody",
        "image": "assets/discoveries/civic/seal.png",
        "kicker": "Police Department",
        "text": "Chain of custody is the record of who held an item, when, and in what condition. The slip’s rule: log the item, tag the enclosure, sign across the seal before it moves, and record a broken seal before reopening. Evidence is only as trustworthy as that record, and my own case file arrived the same way, through Port Authority intake, with the next signature still to come."
      }
    },
    {
      "id": "intake-terminal",
      "kind": "inspect",
      "label": "Read shift handover",
      "at": [
        -5.55,
        1.16,
        -6.824
      ],
      "positions": [
        "entrance",
        "desks"
      ],
      "action": {
        "do": "inspect",
        "title": "Shift handover",
        "text": "Intake: Port referral. Next: request the transfer record. The night shift left one open item for the day desk: the missing-user report I am carrying."
      }
    },
    {
      "id": "recovery-sheet",
      "kind": "inspect",
      "label": "Before you reboot",
      "positions": [
        "recovery"
      ],
      "at": [
        -9.7,
        1.71,
        -15.83
      ],
      "action": [
        {
          "do": "inspect",
          "title": "Before you reboot",
          "text": "Agents here hold what they know in a working cache, and a reboot clears it. Afterward the cache refills only from what is on file, so a witness with nothing written down is, in the department’s words, a very confident stranger. Save the statement with the time and your badge number first. Skye’s workshop is built around the same problem: an AI session that ends forgets everything, so she keeps decision logs, Oracle notes and project records for the next one to start from. If you need a quiet minute, the cot is yours.",
          "image": "assets/discoveries/civic/reboot.png"
        }
      ]
    }
  ],
