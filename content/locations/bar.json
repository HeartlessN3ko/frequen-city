        {
          "do": "inspect",
          "title": "Memorabilia display",
          "text": "Posters from around the city crowd the wall: Karaoke Night, Reboot Ramen, Static Bloom, Null Pointers, Coolant Cola, Sprocket Parcel Co and Antenna Gin. Reboot Ramen, Coolant Cola, Antenna Gin and Sprocket Parcel Co are the city’s own brands, named the way a city of robots would name its noodles, its drinks and its couriers, and the rest read as nights out.",
          "kicker": "Discovery"
        }
      ],
      "doneWhen": {
        "discovered": "bar_memorabilia"
