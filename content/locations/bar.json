        },
        {
          "do": "inspect",
          "title": "Food counter",
          "text": "Every order leaves in a takeaway box with a handful of ketchup packets, the kind that burst when pressed, and with a real knife, because the plastic ones “lack conviction.” Skye’s order went out the way everyone’s does.",
          "kicker": "Discovery"
        }
      ],
      "doneWhen": {
        "discovered": "bar_counter"
      }
