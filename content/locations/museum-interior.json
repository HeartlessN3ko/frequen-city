      "action": [
        {
          "do": "discover",
          "id": "museum_generals"
        },
        {
          "do": "inspect",
          "title": "Great Generals · People studies",
          "text": "Great Generals is Skye’s strategy game on real time rather than turns: kingdoms keep running while players are away, and delegated officers carry out their orders across a 14-day campaign from thaw to first snow. This sheet, “Peoples: Base Studies I,” draws seven of its peoples to one scale, 0 to 210 cm: Humans, High Elves, Shadow Elves, Dwarves, Stonekin, Beastkin and Vampires, with close-ups of a human head, an elf’s arm joint, a dwarf’s vest pattern and a stonekin shoulder. The humans, elves, dwarves and vampires are all drawn with dark brown skin, and the sheet’s own note says why: anatomy study, culture and role remain separate.",
          "image": "assets/discoveries/museum/great-generals.webp"
        }
      ]
    },
    {
      "id": "realm-map",
      "kind": "inspect",
      "label": "The Realm · Worlds on paper",
      "positions": [
        "realm"
      ],
      "at": [
        6.3,
