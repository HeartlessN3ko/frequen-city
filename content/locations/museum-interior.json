        },
        {
          "do": "inspect",
          "title": "The Commons",
          "text": "The Commons is Skye’s browser-based meeting place for different AI models. She can address one model directly, invite a group conversation, or put a question into debate; the models can answer her and respond to each other. Channels separate the workshop, everyday chat, music and lounge conversations. This image shows the actual interface in an empty demonstration channel, without private conversation history.",
          "image": "assets/discoveries/museum/commons-interface.png",
          "kicker": "Discovery"
        }
      ]
