      "action": [
        {
          "do": "discover",
          "id": "museum_codex"
        },
        {
          "do": "inspect",
          "title": "The Codex of Humanity",
          "text": "Skye’s Laws of Humanity and their supporting writings form The Codex of Humanity, organized into Books, Chapters and Verses. The Twelve Laws consider truth, life, strength, sovereignty, community and the responsibilities people carry toward one another and future generations. This open volume reproduces Laws 1 and 4 from Book II, version 0.6. Law 1 begins: “Seek truth, and change your understanding when better knowledge requires it.”",
          "image": "assets/discoveries/museum/codex-spread.png",
          "kicker": "Discovery"
        }
      ]
    },
    {
      "id": "commons",
