      "doneWhen": {
        "discovered": "museum_realm"
      },
      "action": [
        {
          "do": "discover",
          "id": "museum_realm"
        },
        {
          "do": "inspect",
          "title": "The Realm · Terra",
          "text": "The wall map shows Terra, the world The Realm is set on, as a canonical terrain map: an icy north-west, a long continent with a mountain spine through the middle and a violet band labelled “Unstable Region” along the eastern edge. The Realm’s locations database places cities on it. Cameron City, the RIA stronghold, sits where New York would be on an alternate Earth, and the elven city of Silvermoon keeps Hearth Law, under which water is given before names are asked and judgment waits until a guest can stand upright.",
          "image": "assets/discoveries/museum/terra.webp"
        }
      ]
    },
    {
      "id": "codex",
      "kind": "inspect",
      "label": "The Codex of Humanity",
      "at": [
