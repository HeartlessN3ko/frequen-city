        {
          "do": "inspect",
          "title": "Squad Dungeon",
          "text": "Squad Dungeon is a Godot 4 top-down dungeon crawler. The playable slice runs 10 floors with 10 classes, a Goblin Shaman Chief on floor 5, a Slime King on floor 10 and original music.",
          "kicker": "Discovery"
        }
      ]
