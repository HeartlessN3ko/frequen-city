      "action": [
        {
          "do": "discover",
          "id": "vw_devdesk"
        },
        {
          "do": "inspect",
          "title": "Studio project index",
          "text": "The development desk lists everything Voidworks has built or tried. Besides the cabinets there is Shinobi Dash, a Phaser 3 browser platformer with parallax scenery; Realm Knights, a turn-based RPG played in Discord; and a GameHub archive of online games (Battle Rock, Prism Pop Survival, Street Siren, Unit-0, Marble Mayhem, District Rush, Card Table, Meow UNO, Connect 4, Battleship, Risk and Plotluck). It also lists mod and asset work: Project Zomboid mods, Hull Breach hairstyles and furniture, a Voxel Destruction experiment, a Pokémon Battle Advanced patch, a PokéPath TD quality-of-life mod and a PokeMMO battlefield art study. Frequen City: Missing User, the game this desk sits inside, is on the list too.",
          "kicker": "Discovery"
        }
      ]
    },
    {
      "id": "toy-model",
