    {
      "id": "planning",
      "kind": "inspect",
      "label": "Production planning display",
      "at": [
        10.8,
        2.3,
        -4.2
      ],
      "positions": [
        "planning-view"
      ],
      "action": [
        {
          "do": "discover",
          "id": "slos_planning"
        },
        {
          "do": "inspect",
          "title": "Production planning display",
          "text": "The planning board keeps a lane for each family of projects, and every project is registered once so that, in SLOS’s own words, no project starts from zero. A new project begins by pulling the research, prompts and lessons from the ones before it. The lanes are staffed by agents, and the work stays Skye’s to direct.",
          "kicker": "Discovery"
        }
      ],
      "doneWhen": {
        "discovered": "slos_planning"
      }
    },
    {
      "id": "old_prompts",
      "kind": "inspect",
      "label": "Older prompts",
      "at": [
        4.5,
        3.57,
        -32.7
      ],
      "positions": [
        "prompt"
      ],
      "action": [
        {
          "do": "discover",
          "id": "slos_old_prompts"
        },
        {
          "do": "inspect",
          "title": "The prompt library",
          "kicker": "Discovery",
          "text": "SLOS keeps a library of versioned prompts, so a good request is reused instead of rewritten. Songs made with Suno keep their exact lyrics and style prompts, and when those went missing they were recovered from the original conversations, which is how the inputs for Taku’s “Never Let Go” were rebuilt. Saved prompts mean a result Skye likes can be reproduced, and one she doesn’t can be traced back to the words that made it."
        }
      ],
      "doneWhen": {
        "discovered": "slos_old_prompts"
      },
      "reach": 10
    }
