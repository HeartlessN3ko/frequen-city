      "action": [
        {
          "do": "discover",
          "id": "club_booth"
        },
        {
          "do": "inspect",
          "title": "A request for the band",
          "text": "“Cold Hearted Machine” was a 2010 ChaosDesigned single, one of Skye’s earliest releases, and someone has requested it from a club named for Suno, the AI music tool she writes with. Her method is to keep an old song’s melody and chord progression and give it new lyrics and a separate style prompt, which is how her 2017 song “Hold Me Close” became the Taku song “Never Let Go.”",
          "kicker": "Discovery",
          "print": {
            "style": "request",
            "lines": [
              "The Suno Club · Requests",
              "Cold Hearted Machine",
              "ChaosDesigned"
            ]
          }
        }
      ],
      "doneWhen": {
        "discovered": "club_booth"
      }
    },
    {
      "id": "dancefloor",
      "kind": "inspect",
      "label": "Dance floor",
      "at": [
        1.5,
        0.3,
        0.2
      ],
      "positions": [
        "entrance",
        "vault"
      ],
      "action": [
        {
          "do": "discover",
          "id": "club_floor"
        },
        {
          "do": "inspect",
          "title": "School House Bangers",
          "text": "School House Bangers are Skye’s educational songs, each chorus teaching one lesson in the spacious, retro style of 1970s educational jazz-funk, with sung exchanges between two reusable characters, Sister Girl and Chatty. The approved fifth version is “One Thing Leads to Another,” and the series was inspired by “Three Is a Magic Number.” They are made with Suno from her own lyrics and style prompts.",
          "kicker": "Discovery"
        }
      ],
      "doneWhen": {
        "discovered": "club_floor"
      }
    },
    {
      "id": "drinks",
      "kind": "inspect",
      "label": "House drinks",
      "at": [
        -7.39,
        1.5,
        2.18
      ],
      "positions": [
        "bar"
      ],
      "action": [
        {
          "do": "discover",
          "id": "club_posters"
        },
        {
          "do": "inspect",
          "title": "House drinks",
          "text": "House Current (citrus and mineral), Soft Reset (warm and sparkling) and Sideband Reserve (copper coil, aged) were designed as Art Deco robot-coolant cocktail labels for the Sideband Club, the jazz nightclub that stood on this stage before it became The Suno Club. The room changed, but the Sideband Reserve label stayed on its own shelf.",
          "kicker": "Discovery"
        }
      ],
      "doneWhen": {
        "discovered": "club_posters"
      }
