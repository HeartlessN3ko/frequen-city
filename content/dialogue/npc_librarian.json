    "skye": {
      "speaker": "librarian",
      "text": "I can point you to her books. Her whereabouts are another matter.",
      "end": true
    },
    "wrote": {
      "speaker": "librarian",
      "text": "The Life of Skye. For that one she built a make-believe browser that digs through the old internet.",
      "end": true
    },
    "card": {
      "speaker": "librarian",
      "text": "Taku. Her band is named for her first Japanese childhood friend. That card is my favorite in the whole catalog.",
      "end": true
    },
    "end": {
      "speaker": "librarian",
      "text": "Come back anytime. Quietly.",
      "end": true
