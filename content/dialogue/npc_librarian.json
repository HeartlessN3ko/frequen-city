    "menu": {
      "choices": [
        {
          "id": "n_librarian_skye",
          "text": "Have you seen Skye?",
          "next": "skye",
          "when": {
            "all": [
              {
                "flag": "briefed"
              },
              {
                "not": {
                  "seen": "npc_librarian#skye"
                }
              }
            ]
          }
        },
        {
          "id": "n_librarian_wrote",
          "text": "What did Skye write?",
          "next": "wrote",
          "when": {
            "not": {
              "seen": "npc_librarian#wrote"
            }
          }
        },
        {
          "id": "n_librarian_card",
          "text": "Do you have a favorite card in the catalog?",
          "next": "card",
          "when": {
