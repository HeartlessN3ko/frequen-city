      "speaker": "librarian",
      "text": "Shh. Welcome to the library. Reading is allowed. Everything else is negotiable.",
      "next": "menu"
    },
    "back": {
      "speaker": "librarian",
      "text": "You again. Library voice, please.",
      "next": "menu"
